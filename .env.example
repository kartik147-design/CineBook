# Use strong, unique values for any shared or staging deployment.
CINEBOOK_AUTH_SECRET=replace-with-a-long-random-auth-secret
TICKET_SECRET=replace-with-a-different-long-random-ticket-secret
ADMIN_EMAIL=admin@cinebook.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
MONGODB_ROOT_USERNAME=cinebook
MONGODB_ROOT_PASSWORD=replace-with-a-strong-mongodb-password
MONGODB_URI=
MONGODB_DATABASE=cinebook
MONGODB_USERNAME=
MONGODB_PASSWORD=

# The browser and API share this public port.
CINEBOOK_PORT=5000
STAGING_PORT=5000
