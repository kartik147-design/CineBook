PORT: 5000
CINEBOOK_DATA_DIR: /app/data
CINEBOOK_AUTH_SECRET: ${CINEBOOK_AUTH_SECRET:?Set CINEBOOK_AUTH_SECRET in root .env}
TICKET_SECRET: ${TICKET_SECRET:?Set TICKET_SECRET in root .env}
ADMIN_EMAIL: ${ADMIN_EMAIL:-admin@cinebook.local}
ADMIN_PASSWORD: ${ADMIN_PASSWORD:?Set ADMIN_PASSWORD in root .env}