PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook
MONGODB_DATABASE=cinebook
# Leave these blank when the local MongoDB server does not require authentication.
MONGODB_USERNAME=
MONGODB_PASSWORD=
CINEBOOK_AUTH_SECRET=replace-with-a-long-random-auth-secret
TICKET_SECRET=replace-with-a-different-long-random-ticket-secret
ADMIN_EMAIL=admin@cinebook.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password